#!/bin/bash
# Root helper for the ghelper-profile widget (invoked via sudo -n,
# allowed passwordless by /etc/sudoers.d/power-mode).
# extreme = max battery savings, normal = stock behavior.
#
# Note: CPU boost is NOT touched here — power-profiles-daemon manages
# per-policy boost on amd_pstate, and writing the global boost knob makes
# PPD profile switches fail with EINVAL (profile then "jumps back").
# Panel ABM is also left alone on extreme: changing it visibly shifts
# screen brightness on every profile switch.

PANEL=$(ls /sys/class/drm/card*-eDP-*/amdgpu/panel_power_savings 2>/dev/null | head -1)
WIFI=$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')

# Force runtime PM on for every NVIDIA PCI function so an idle dGPU can
# drop to D3cold. supergfxd's udev rules flip power/control back to "on"
# when the driver unbinds (e.g. switching to Integrated mode), which can
# leave a driverless dGPU stuck in D0 burning 10-15 W. "auto" is correct
# whether or not the nvidia driver is bound: bound GPUs runtime-suspend
# through the driver, driverless ones through the PCI core.
nvidia_runtime_pm() {
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x10de" ] || continue
        [ -w "$dev/power/control" ] || continue
        echo auto > "$dev/power/control" 2>/dev/null
    done
}

# Pin every NVIDIA PCI function in D0 by disabling runtime PM
# (power/control = "on"). Used for the Performance profile in Hybrid mode
# so the dGPU never drops to D3cold: it stays instantly available to any
# app or game that wants to render on it, instead of paying the wake-up
# latency (or being skipped entirely) on a runtime-suspended card. In
# Integrated mode there is no NVIDIA device on the bus, so this is a
# no-op and Performance behaves exactly like the other profiles.
nvidia_dgpu_awake() {
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x10de" ] || continue
        [ -w "$dev/power/control" ] || continue
        echo on > "$dev/power/control" 2>/dev/null
    done
}

# Nudge amd-pstate / intel EPP after PPD sets the platform profile.
# Safe: only writes a preference that the CPU advertises. Never touches
# the global boost knob (that makes PPD profile switches fail with EINVAL).
# No-op on kernels / CPUs without energy_performance_preference.
set_epp() {
    local pref="$1" f avail
    [ -n "$pref" ] || return 0
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -w "$f" ] || continue
        avail="$(cat "${f%/*}/energy_performance_available_preferences" 2>/dev/null)"
        case " $avail " in
            *" $pref "*) echo "$pref" > "$f" 2>/dev/null ;;
        esac
    done
}

# Paths are overridable for the test suite (tests/run-tests.sh); real
# invocations never set these variables.
GFX_CONF="${POWER_DECK_GFX_CONF:-/etc/supergfxd.conf}"
GFX_STATE_DIR="${POWER_DECK_GFX_STATE_DIR:-/var/lib/power-deck}"
GFX_PENDING="$GFX_STATE_DIR/gfx-pending"
MODPROBE_DIR="${POWER_DECK_MODPROBE_DIR:-/etc/modprobe.d}"
MODLOAD_DIR="${POWER_DECK_MODLOAD_DIR:-/etc/modules-load.d}"
MODLOAD_SRC_DIR="${POWER_DECK_MODLOAD_SRC_DIR:-/usr/lib/modules-load.d}"
DROPIN_DIR="${POWER_DECK_DROPIN_DIR:-/etc/systemd/system}"
GUARD_MODPROBE="$MODPROBE_DIR/power-deck-integrated.conf"
GUARD_MARKER="# Managed by Power Deck"
# NVIDIA userspace services that must not run in Integrated mode:
# nvidia-persistenced re-loads the nvidia module through the setuid
# nvidia-modprobe helper (blacklists do not stop explicit loads) and
# racing that against supergfxd's PCI device removal wedges it in
# uninterruptible kernel state — which blocks DRM for the whole session
# and boots to a black screen with a blinking cursor.
GUARD_SERVICES="nvidia-persistenced.service nvidia-powerd.service"

conf_mode() {
    sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' "$GFX_CONF" 2>/dev/null | head -n1
}

# Keep NVIDIA modules from being loaded before supergfxd when the
# configured mode is Integrated. Root cause of the "switch to Integrated
# then reboot hangs" bug: early boot loads nvidia/nvidia_drm (udev
# autoload, modules-load.d, nvidia_drm.fbdev=1), supergfxd then cannot
# rmmod them ("Module nvidia_modeset is in use"), its action thread
# wedges in uninterruptible kernel state and the next shutdown hangs
# after the final SIGKILL. With the modules never loaded (or unloaded
# right before supergfxd starts) the Integrated switch is clean.
# Everything here is reconciled on every boot, so a mode change made
# behind Power Deck's back (e.g. supergfxctl directly) heals itself.
nvidia_boot_guard() {
    local mode f dst
    mode="$(conf_mode)"
    if [ "$mode" = "Integrated" ]; then
        mkdir -p "$MODPROBE_DIR" "$MODLOAD_DIR"
        {
            echo "$GUARD_MARKER (power-mode gfx-commit) — removed automatically"
            echo "# when the configured supergfxd mode is not Integrated. Stops udev"
            echo "# from auto-loading NVIDIA modules before supergfxd can remove the"
            echo "# dGPU: a loaded nvidia_drm makes supergfxd wedge and hangs shutdown."
            echo "blacklist nvidia"
            echo "blacklist nvidia_drm"
            echo "blacklist nvidia_modeset"
            echo "blacklist nvidia_uvm"
        } > "$GUARD_MODPROBE"
        # blacklist does not stop explicit loads from modules-load.d (e.g.
        # nvidia-utils.conf inserting nvidia-uvm), so mask those lists with
        # same-named empty overrides in /etc.
        for f in "$MODLOAD_SRC_DIR"/*.conf; do
            [ -f "$f" ] || continue
            grep -q '^nvidia' "$f" 2>/dev/null || continue
            dst="$MODLOAD_DIR/$(basename "$f")"
            # never clobber a file the user created themselves
            if [ -e "$dst" ] && ! grep -q "^$GUARD_MARKER" "$dst" 2>/dev/null; then
                continue
            fi
            echo "$GUARD_MARKER — masks $(basename "$f") while GPU mode is Integrated" > "$dst"
        done
        # NVIDIA userspace services load the nvidia module explicitly via
        # the setuid nvidia-modprobe helper, which ignores blacklists.
        # Racing supergfxd's PCI removal at boot wedges them unkillable and
        # the session never starts (black screen, blinking cursor). A
        # conditional drop-in keeps them off exactly while the guard
        # blacklist file exists, and restores them the moment it is gone.
        local svc
        for svc in $GUARD_SERVICES; do
            mkdir -p "$DROPIN_DIR/$svc.d"
            {
                echo "$GUARD_MARKER (power-mode gfx-commit)."
                echo "# Skips this service while the GPU mode is Integrated: it would"
                echo "# re-load the NVIDIA kernel module via setuid nvidia-modprobe and"
                echo "# race supergfxd's dGPU removal, wedging boot at a black screen."
                echo "[Unit]"
                echo "ConditionPathExists=!$GUARD_MODPROBE"
            } > "$DROPIN_DIR/$svc.d/power-deck.conf"
        done
        # best effort for the current boot: stop the loaders and unload
        # anything already inserted (runs before supergfxd, the NVIDIA
        # services and the session at boot; harmless later)
        if [ -z "${POWER_DECK_TEST:-}" ]; then
            if [ "$(systemctl is-system-running 2>/dev/null)" != "stopping" ]; then
                systemctl daemon-reload 2>/dev/null
                systemctl stop $GUARD_SERVICES 2>/dev/null
            fi
            modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia 2>/dev/null
            # exact module names only — a bare ^nvidia would also match the
            # unrelated nvidia_wmi_ec_backlight driver
            if grep -qE '^(nvidia|nvidia_drm|nvidia_modeset|nvidia_uvm) ' /proc/modules 2>/dev/null; then
                echo "gfx-commit: warning: NVIDIA modules still loaded, supergfxd may fail to switch" >&2
            else
                echo "gfx-commit: NVIDIA module load guards active (Integrated)"
            fi
        fi
    else
        rm -f "$GUARD_MODPROBE"
        for f in "$MODLOAD_DIR"/*.conf; do
            [ -f "$f" ] || continue
            grep -q "^$GUARD_MARKER" "$f" 2>/dev/null && rm -f "$f"
        done
        local svc changed=0
        for svc in $GUARD_SERVICES; do
            if [ -f "$DROPIN_DIR/$svc.d/power-deck.conf" ]; then
                rm -f "$DROPIN_DIR/$svc.d/power-deck.conf"
                rmdir "$DROPIN_DIR/$svc.d" 2>/dev/null
                changed=1
            fi
        done
        if [ -z "${POWER_DECK_TEST:-}" ] && [ "$changed" = 1 ] \
            && [ "$(systemctl is-system-running 2>/dev/null)" != "stopping" ]; then
            systemctl daemon-reload 2>/dev/null
        fi
    fi
    return 0
}

case "$1" in
    # Queue a graphics mode for the next boot. supergfxctl -m is
    # deliberately NOT used: even with always_reboot it first attempts a
    # live driver unload, which fails while a session holds nvidia_drm
    # and then wedges the daemon on a PCI unbind in uninterruptible
    # kernel state — the process survives SIGKILL and the next
    # reboot/shutdown hangs on a black screen.
    #
    # Editing /etc/supergfxd.conf while the daemon runs is not safe
    # either: if supergfxd restarts mid-session (crash, upgrade — it
    # has Restart=always) it applies the config mode LIVE at startup
    # and wedges the same way. So the target mode is only STAGED here;
    # power-deck-gfx-apply.service commits it into the config at
    # shutdown (after supergfxd stopped) or early boot (before it
    # starts), when no daemon can react to the change.
    # AsusMuxDgpu is intentionally not accepted: MUX switching does not
    # work reliably through supergfxd, so the widget no longer offers it.
    gfx-mode)
        case "${2:-}" in
            Integrated|Hybrid|AsusEgpu|Vfio) ;;
            *) echo "Usage: $0 gfx-mode Integrated|Hybrid|AsusEgpu|Vfio" >&2; exit 1 ;;
        esac
        [ -f "$GFX_CONF" ] || { echo "$GFX_CONF not found" >&2; exit 1; }
        cur=$(conf_mode)
        if [ "$2" = "$cur" ]; then
            # re-selecting the configured mode cancels a queued switch
            rm -f "$GFX_PENDING"
        else
            mkdir -p "$GFX_STATE_DIR" && chmod 755 "$GFX_STATE_DIR"
            printf '%s\n' "$2" > "$GFX_PENDING" || exit 1
            chmod 644 "$GFX_PENDING"
            sync "$GFX_PENDING"
        fi
        exit 0
        ;;
    # Commit a staged graphics mode into supergfxd's config. Only safe
    # while supergfxd is NOT running; invoked by
    # power-deck-gfx-apply.service at shutdown and early boot.
    gfx-commit)
        if [ -s "$GFX_PENDING" ]; then
            mode=$(head -n1 "$GFX_PENDING")
            case "$mode" in
                Integrated|Hybrid|AsusEgpu|Vfio) ;;
                *) mode="" ;;
            esac
            if [ -n "$mode" ] && [ -f "$GFX_CONF" ]; then
                # tolerant of whitespace variations in case supergfxd
                # rewrites its config in a different style
                sed -i "s/\"mode\"[[:space:]]*:[[:space:]]*\"[A-Za-z]*\"/\"mode\": \"$mode\"/" "$GFX_CONF"
                sync "$GFX_CONF"
                if [ "$(conf_mode)" = "$mode" ]; then
                    rm -f "$GFX_PENDING"
                else
                    echo "gfx-commit: failed to write mode $mode into $GFX_CONF" >&2
                    nvidia_boot_guard
                    exit 1
                fi
            else
                rm -f "$GFX_PENDING"
            fi
        fi
        # reconcile the NVIDIA boot guard on every boot/shutdown, even when
        # nothing was queued (heals external config edits and past failures)
        nvidia_boot_guard
        exit 0
        ;;
    extreme)
        echo powersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null
        [ -n "$WIFI" ] && iw dev "$WIFI" set power_save on
        nvidia_runtime_pm
        ;;
    normal)
        # Power Saver desktop extras (PPD still owns EPP via power-saver).
        [ -n "$PANEL" ] && echo 0 > "$PANEL"
        echo default > /sys/module/pcie_aspm/parameters/policy 2>/dev/null
        [ -n "$WIFI" ] && iw dev "$WIFI" set power_save off
        # Re-enable runtime suspend so the dGPU can idle to D3cold again
        # after leaving Performance (which pins it awake).
        nvidia_runtime_pm
        ;;
    balanced-ac)
        # Balanced on AC: snappy desktop without waking the dGPU.
        # PPD's "balanced" often lands on EPP balance_power on amd_pstate;
        # nudge to balance_performance for faster ramp while the ACPI
        # platform profile stays balanced (throughput budget).
        [ -n "$PANEL" ] && echo 0 > "$PANEL"
        echo default > /sys/module/pcie_aspm/parameters/policy 2>/dev/null
        [ -n "$WIFI" ] && iw dev "$WIFI" set power_save off
        nvidia_runtime_pm
        set_epp balance_performance
        ;;
    balanced-batt)
        # Balanced on battery: keep PPD balanced (not power-saver) for
        # decent responsiveness, but reclaim Wi-Fi / ASPM savings and
        # leave the dGPU free to D3cold. Explicit EPP reset matters when
        # leaving Performance — PPD does not always rewrite EPP on the
        # balanced hop, and balance_performance would keep draining.
        [ -n "$PANEL" ] && echo 0 > "$PANEL"
        echo powersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null
        [ -n "$WIFI" ] && iw dev "$WIFI" set power_save on
        nvidia_runtime_pm
        set_epp balance_power
        ;;
    performance)
        # All-out: same desktop extras as AC balanced, but pin the dGPU
        # awake so Hybrid + Performance drives apps/games without wake
        # latency. EPP performance reinforcer (PPD also sets this).
        [ -n "$PANEL" ] && echo 0 > "$PANEL"
        echo default > /sys/module/pcie_aspm/parameters/policy 2>/dev/null
        [ -n "$WIFI" ] && iw dev "$WIFI" set power_save off
        nvidia_dgpu_awake
        set_epp performance
        ;;
    *)
        echo "Usage: $0 extreme|normal|balanced-ac|balanced-batt|performance|gfx-mode <Mode>|gfx-commit" >&2
        exit 1
        ;;
esac
exit 0
