#!/bin/bash
# ghelper-profile - Switch power profiles (used by the Plasma profile widget)
# Usage: ghelper-profile [extreme|power|balanced|performance|status]
#
# extreme     power-saver profile + boost off, panel dimming (ABM), 60Hz,
#             wifi powersave, PCIe ASPM powersave
# power       power-saver profile, normal extras
# balanced    balanced profile, normal extras
# performance performance profile, normal extras

STATE_DIR="$HOME/.local/state"
STATE_FILE="$STATE_DIR/ghelper-profile-mode"
HELPER="/usr/local/bin/power-mode"
PANEL_MODE_HZ_HIGH="2560x1600@165"
PANEL_MODE_HZ_LOW="2560x1600@60"

mkdir -p "$STATE_DIR"

set_refresh() {
    kscreen-doctor "output.eDP-1.mode.$1" >/dev/null 2>&1
}

set_profile() {
    local mode="$1"
    case "$mode" in
        extreme)
            powerprofilesctl set power-saver
            sudo -n "$HELPER" extreme
            set_refresh "$PANEL_MODE_HZ_LOW"
            ;;
        power)
            powerprofilesctl set power-saver
            sudo -n "$HELPER" normal
            set_refresh "$PANEL_MODE_HZ_HIGH"
            ;;
        balanced)
            powerprofilesctl set balanced
            sudo -n "$HELPER" normal
            set_refresh "$PANEL_MODE_HZ_HIGH"
            ;;
        performance)
            powerprofilesctl set performance
            sudo -n "$HELPER" normal
            set_refresh "$PANEL_MODE_HZ_HIGH"
            ;;
    esac
    echo "$mode" > "$STATE_FILE"
    echo "Profile set to: $mode"
}

get_status() {
    local ppd saved
    ppd=$(powerprofilesctl get 2>/dev/null)
    saved=$(cat "$STATE_FILE" 2>/dev/null)

    case "$ppd" in
        power-saver)
            # extreme and power both map to power-saver; disambiguate via state
            if [ "$saved" = "extreme" ]; then
                echo "extreme"
            else
                echo "power"
            fi
            ;;
        balanced)    echo "balanced" ;;
        performance) echo "performance" ;;
        *)           echo "unknown" ;;
    esac
}

case "${1}" in
    extreme|power|balanced|performance)
        set_profile "$1"
        ;;
    status|current)
        get_status
        ;;
    *)
        echo "Usage: $0 [extreme|power|balanced|performance|status]"
        exit 1
        ;;
esac
