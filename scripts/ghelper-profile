#!/bin/bash
# ghelper-profile - Switch power profiles (used by the Plasma profile widget)
# Usage: ghelper-profile [extreme|power|balanced|performance|status]
#
# extreme     power-saver profile + low panel refresh rate,
#             wifi powersave, PCIe ASPM powersave
# power       power-saver profile, normal extras
# balanced    balanced profile; AC = snappy extras + EPP balance_performance,
#             battery = Wi-Fi/ASPM powersave (decent battery, still responsive)
# performance performance profile, dGPU pinned awake, always-high refresh,
#             ASPM performance
#
# Each mode has its own fan curve (fan-ctl). Extreme and Power Saver
# share the firmware LowPower slot, so the stored curve is rewritten
# on every switch.

STATE_DIR="$HOME/.local/state"
STATE_FILE="$STATE_DIR/ghelper-profile-mode"
HELPER="/usr/local/bin/power-mode"
REFRESH_CTL="$HOME/.local/bin/refresh-ctl"
[ -x "$REFRESH_CTL" ] || REFRESH_CTL="$(dirname "$0")/refresh-ctl"
FAN_CTL="$HOME/.local/bin/fan-ctl"
[ -x "$FAN_CTL" ] || FAN_CTL="$(dirname "$0")/fan-ctl"
BUSCTL="${BUSCTL:-/usr/bin/busctl}"
ASUSD_DEST="xyz.ljones.Asusd"
ASUSD_PATH="/xyz/ljones"
PLAT_IFACE="xyz.ljones.Platform"

mkdir -p "$STATE_DIR"

# Same AC detection as refresh-ctl / anime-power-watch.
on_ac() {
    local ps type online status
    for ps in /sys/class/power_supply/*; do
        [ -e "$ps" ] || continue
        type="$(cat "$ps/type" 2>/dev/null)"
        online="$(cat "$ps/online" 2>/dev/null)"
        case "$type" in
            Mains|USB*) [ "$online" = "1" ] && return 0 ;;
        esac
    done
    for ps in /sys/class/power_supply/*; do
        [ "$(cat "$ps/type" 2>/dev/null)" = "Battery" ] || continue
        status="$(cat "$ps/status" 2>/dev/null)"
        case "$status" in
            Charging|Full|"Not charging") return 0 ;;
        esac
    done
    return 1
}

# Power Deck owns the platform profile. asusd's AC/battery auto-switch
# would yank Extreme/Balanced to Performance on plug-in and undo the
# per-mode fan curve after login.
pin_asusd_owner() {
    [ -x "$BUSCTL" ] || return 0
    "$BUSCTL" set-property "$ASUSD_DEST" "$ASUSD_PATH" "$PLAT_IFACE" \
        ChangePlatformProfileOnAc b false >/dev/null 2>&1 || true
    "$BUSCTL" set-property "$ASUSD_DEST" "$ASUSD_PATH" "$PLAT_IFACE" \
        ChangePlatformProfileOnBattery b false >/dev/null 2>&1 || true
}

# asusd CPUEPP (rog-platform, D-Bus type u):
#   0 Default, 1 Performance, 2 BalancePerformance, 3 BalancePower, 4 Power
# With platform_profile_linked_epp, asusd rewrites sysfs EPP from
# profile_balanced_epp whenever Balanced is live. A sysfs-only nudge
# from power-mode is not enough — keep the asusd property in sync so
# asusd cannot overwrite AC balance_performance with BalancePower.
set_asusd_balanced_epp() {
    local epp_u="$1"
    [ -x "$BUSCTL" ] || return 0
    "$BUSCTL" set-property "$ASUSD_DEST" "$ASUSD_PATH" "$PLAT_IFACE" \
        ProfileBalancedEpp u "$epp_u" >/dev/null 2>&1 || true
}

apply_fans() {
    [ -x "$FAN_CTL" ] || return 0
    "$FAN_CTL" apply "$1" >/dev/null 2>&1 || true
}

# Re-apply the root-helper knobs for the saved mode. Used on profile
# switch and by anime-power-watch on plug/unplug (balanced AC vs batt).
apply_helper() {
    local mode="$1"
    case "$mode" in
        extreme)
            sudo -n "$HELPER" extreme
            ;;
        power)
            sudo -n "$HELPER" normal
            ;;
        balanced)
            if on_ac; then
                set_asusd_balanced_epp 2
                sudo -n "$HELPER" balanced-ac
            else
                set_asusd_balanced_epp 3
                sudo -n "$HELPER" balanced-batt
            fi
            ;;
        performance)
            sudo -n "$HELPER" performance
            ;;
    esac
}

set_profile() {
    local mode="$1"
    # Save first: refresh-ctl reads this file to make "auto" profile-aware
    # (extreme -> low rate without clobbering the user's saved refresh mode).
    echo "$mode" > "$STATE_FILE"
    pin_asusd_owner
    case "$mode" in
        extreme)
            powerprofilesctl set power-saver
            ;;
        power)
            powerprofilesctl set power-saver
            ;;
        balanced)
            powerprofilesctl set balanced
            ;;
        performance)
            powerprofilesctl set performance
            ;;
    esac
    apply_helper "$mode"
    apply_fans "$mode"
    "$REFRESH_CTL" sync >/dev/null 2>&1
    echo "Profile set to: $mode"
}

get_status() {
    local ppd saved
    ppd=$(powerprofilesctl get 2>/dev/null)
    saved=$(cat "$STATE_FILE" 2>/dev/null)

    case "$ppd" in
        power-saver)
            # extreme and power both map to power-saver; disambiguate via state
            if [ "$saved" = "extreme" ]; then
                echo "extreme"
            else
                echo "power"
            fi
            ;;
        balanced)    echo "balanced" ;;
        performance) echo "performance" ;;
        *)           echo "unknown" ;;
    esac
}

case "${1}" in
    extreme|power|balanced|performance)
        set_profile "$1"
        ;;
    helper-sync)
        # Plug/unplug path: re-apply AC-aware extras without flipping PPD.
        apply_helper "$(cat "$STATE_FILE" 2>/dev/null)"
        ;;
    status|current)
        get_status
        ;;
    *)
        echo "Usage: $0 [extreme|power|balanced|performance|status]"
        exit 1
        ;;
esac
