#!/bin/bash
# fnlock-ctl - Fn lock control for the Plasma profile widget
# Uses g-helper-linux-style software remapping (evdev grab + uinput).
# State file semantics (shared with fnlock-daemon.py):
#   on  = FN-lock on  -> F1-F12 act as media keys (remap active)
#   off = FN-lock off -> F1-F12 passthrough (default)
# Usage: fnlock-ctl [on|off|status|restore]

STATE_FILE="$HOME/.local/state/fnlock"
SERVICE="fnlock-daemon.service"
mkdir -p "$HOME/.local/state"

ensure_service() {
    systemctl --user enable --now "$SERVICE" >/dev/null 2>&1
}

reload_daemon() {
    if systemctl --user is-active --quiet "$SERVICE"; then
        pid=$(systemctl --user show -p MainPID --value "$SERVICE" 2>/dev/null)
        if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
            kill -HUP "$pid" 2>/dev/null && return
        fi
    fi
    systemctl --user restart "$SERVICE" >/dev/null 2>&1 || ensure_service
}

case "$1" in
    on|off)
        echo "$1" > "$STATE_FILE"
        ensure_service
        reload_daemon
        ;;
    restore)
        # Default to FN-lock off if no saved state exists.
        s=$(cat "$STATE_FILE" 2>/dev/null)
        [ "$s" = "on" ] || [ "$s" = "off" ] || echo off > "$STATE_FILE"
        ensure_service
        reload_daemon
        ;;
    status)
        s=$(cat "$STATE_FILE" 2>/dev/null)
        if [ "$s" = "on" ]; then
            echo on
        else
            echo off
        fi
        ;;
    *)
        echo "Usage: $0 [on|off|status|restore]"
        exit 1
        ;;
esac
