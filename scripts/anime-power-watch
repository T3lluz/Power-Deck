#!/bin/bash
# anime-power-watch - keep AC-dependent settings in sync with plug/unplug:
# AniMe Matrix, panel refresh (refresh-ctl auto), fan curve, and the
# balanced AC/battery power-mode extras (Wi-Fi / ASPM / EPP).
# Run by anime-power-sync.service. Listens for power_supply udev events;
# falls back to polling if udevadm is unavailable.

ANIME_CTL="$HOME/.local/bin/anime-ctl"
[ -x "$ANIME_CTL" ] || ANIME_CTL="$(dirname "$0")/anime-ctl"
REFRESH_CTL="$HOME/.local/bin/refresh-ctl"
[ -x "$REFRESH_CTL" ] || REFRESH_CTL="$(dirname "$0")/refresh-ctl"
FAN_CTL="$HOME/.local/bin/fan-ctl"
[ -x "$FAN_CTL" ] || FAN_CTL="$(dirname "$0")/fan-ctl"
PROFILE_CTL="$HOME/.local/bin/ghelper-profile"
[ -x "$PROFILE_CTL" ] || PROFILE_CTL="$(dirname "$0")/ghelper-profile"

sync() {
    "$ANIME_CTL" sync >/dev/null 2>&1
    "$REFRESH_CTL" sync >/dev/null 2>&1
    # Re-assert the active mode's fan curve. asusd used to switch the
    # platform profile on AC/battery; even with that disabled, a late
    # asusd write can otherwise leave the wrong curve applied.
    [ -x "$FAN_CTL" ] && "$FAN_CTL" apply >/dev/null 2>&1 || true
    # Balanced flips Wi-Fi/ASPM/EPP on plug/unplug; other modes re-assert
    # their root-helper knobs so a late asusd/PPD write cannot stick.
    [ -x "$PROFILE_CTL" ] && "$PROFILE_CTL" helper-sync >/dev/null 2>&1 || true
}

# The udev burst can arrive before the AC adapter's "online" attribute
# settles, so a single sync may act on stale state. Run a second pass
# shortly after to catch the final state.
sync_twice() {
    sync
    ( sleep 2; sync ) &
}

# Initial sync so state is correct at login.
sync

if command -v udevadm >/dev/null 2>&1; then
    # stdbuf keeps the pipe line-buffered so events arrive immediately.
    stdbuf -oL udevadm monitor --udev --subsystem-match=power_supply 2>/dev/null |
    while read -r _; do
        # Coalesce event bursts (plug/unplug emits several events at once).
        while read -r -t 1 _; do :; done
        sync_twice
    done
fi

# Fallback: poll the AC adapter state (wall adapter or USB-C PD).
prev=""
while :; do
    cur=$(for ps in /sys/class/power_supply/*; do
        case "$(cat "$ps/type" 2>/dev/null)" in
            Mains|USB*) cat "$ps/online" 2>/dev/null ;;
        esac
    done | sort -r | head -1)
    if [ "$cur" != "$prev" ]; then
        prev="$cur"
        sync_twice
    fi
    sleep 2
done
