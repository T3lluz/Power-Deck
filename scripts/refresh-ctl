#!/bin/bash
# refresh-ctl - Internal panel refresh-rate control for the Plasma widget.
#
# Auto-detects the internal panel (eDP*) and its modes, so it works on any
# laptop: "high" is the highest refresh rate at the panel's native
# resolution, "low" is 60 Hz (or the lowest rate available if there is no
# 60 Hz mode), "auto" picks high on AC and low on battery.
#
# Usage: refresh-ctl [auto|low|high|sync|status]
#
#   auto|low|high   save the mode and apply it
#   sync            re-apply the saved mode (used on AC plug/unplug and
#                   profile switches)
#   status          print "<mode> <low_hz> <high_hz> <current_hz>"
#
# "auto" is profile-aware: low rate on battery or in the extreme profile,
# high rate otherwise. Explicit low/high modes always win.

STATE_DIR="$HOME/.local/state"
MODE_FILE="$STATE_DIR/refresh-mode"
PROFILE_FILE="$STATE_DIR/ghelper-profile-mode"
mkdir -p "$STATE_DIR"

# kscreen-doctor is a session tool: without the session's WAYLAND_DISPLAY
# (and friends) it aborts with SIGABRT. Callers like the udev power
# watcher run from a systemd user service that starts before Plasma
# exports those variables, which silently broke every AC plug/unplug
# refresh sync. Import whatever is missing from the systemd user session.
import_session_env() {
    [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && return 0
    local line var
    while IFS= read -r line; do
        case "$line" in
            WAYLAND_DISPLAY=*|DISPLAY=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_RUNTIME_DIR=*|XAUTHORITY=*)
                var="${line%%=*}"
                if [ -z "$(eval "printf %s \"\${$var:-}\"")" ]; then
                    export "$line"
                fi
                ;;
        esac
    done < <(systemctl --user show-environment 2>/dev/null)
}
import_session_env

# True whenever the laptop is running on external power. Checks several
# signals because a single one is unreliable right after a cold boot:
#   1. a wall adapter (Mains) reporting online
#   2. a USB-C / Thunderbolt PD source reporting online (the G14 and many
#      modern laptops charge over USB-C, which shows up as a USB-type
#      power supply, never as Mains)
#   3. the battery status — "Charging"/"Full"/"Not charging" all mean
#      external power is present; only "Discharging" means true battery.
# The battery-status check is the backstop that fixes "auto stays at
# 60 Hz while charging": at boot the Mains "online" flag can still read 0
# for a moment, but the charger is clearly attached if the battery is
# charging.
on_ac() {
    local ps type online status
    for ps in /sys/class/power_supply/*; do
        [ -e "$ps" ] || continue
        type="$(cat "$ps/type" 2>/dev/null)"
        online="$(cat "$ps/online" 2>/dev/null)"
        case "$type" in
            Mains|USB*) [ "$online" = "1" ] && return 0 ;;
        esac
    done
    for ps in /sys/class/power_supply/*; do
        [ "$(cat "$ps/type" 2>/dev/null)" = "Battery" ] || continue
        status="$(cat "$ps/status" 2>/dev/null)"
        case "$status" in
            Charging|Full|"Not charging") return 0 ;;
        esac
    done
    return 1
}

saved_mode() {
    local m
    m=$(cat "$MODE_FILE" 2>/dev/null)
    case "$m" in
        auto|low|high) echo "$m" ;;
        *) echo high ;;
    esac
}

# Prints panel facts for the internal display:
#   "<output-name> <low-id> <low-hz> <high-id> <high-hz> <current-id> <current-hz>"
# Empty output when there is no eDP panel or kscreen-doctor is unavailable.
panel_info() {
    kscreen-doctor --json 2>/dev/null | python3 -c '
import json, sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

panel = None
for out in data.get("outputs", []):
    if out.get("enabled") and str(out.get("name", "")).startswith("eDP"):
        panel = out
        break
if panel is None:
    sys.exit(0)

modes = panel.get("modes", [])
if not modes:
    sys.exit(0)

# Native resolution = largest area on the panel.
native = max(modes, key=lambda m: m["size"]["width"] * m["size"]["height"])["size"]
native_modes = [m for m in modes if m["size"] == native]

high = max(native_modes, key=lambda m: m.get("refreshRate", 0))
sixty = [m for m in native_modes if 59 <= m.get("refreshRate", 0) <= 61]
low = sixty[0] if sixty else min(native_modes, key=lambda m: m.get("refreshRate", 0))

cur_id = panel.get("currentModeId", "")
cur = next((m for m in modes if m["id"] == cur_id), high)

hz = lambda m: round(m.get("refreshRate", 0))
print(panel["name"], low["id"], hz(low), high["id"], hz(high), cur["id"], hz(cur))
'
}

# Set the panel to "high" or "low"; no-op when already there (avoids
# needless modesets, which blank the screen for a split second).
apply() {
    local name low_id low_hz high_id high_hz cur_id cur_hz target
    read -r name low_id low_hz high_id high_hz cur_id cur_hz <<< "$(panel_info)"
    [ -n "$name" ] || return 1
    target="$high_id"
    [ "$1" = "low" ] && target="$low_id"
    [ "$target" = "$cur_id" ] && return 0
    kscreen-doctor "output.${name}.mode.${target}" >/dev/null 2>&1
}

# True while the extreme profile is really driving the machine. The saved
# profile file alone is not enough: PowerDevil auto-switches the PPD
# profile on AC plug/unplug (e.g. extreme/power-saver -> balanced on AC)
# without touching Power Deck's state, and the extreme 60 Hz cap must
# lift with it — otherwise "auto" sits at 60 Hz on the charger until the
# user manually clicks a profile. Without powerprofilesctl fall back to
# trusting the saved profile.
extreme_active() {
    [ "$(cat "$PROFILE_FILE" 2>/dev/null)" = "extreme" ] || return 1
    command -v powerprofilesctl >/dev/null 2>&1 || return 0
    local ppd
    ppd="$(powerprofilesctl get 2>/dev/null)"
    [ -z "$ppd" ] || [ "$ppd" = "power-saver" ]
}

desired() {
    case "$(saved_mode)" in
        low)  echo low ;;
        high) echo high ;;
        auto)
            if extreme_active; then
                echo low
            elif on_ac; then
                echo high
            else
                echo low
            fi
            ;;
    esac
}

# apply with verification: kscreen-doctor can fail or be ignored when a
# modeset races with compositor work (e.g. right after AC plug/unplug or
# a profile switch), so confirm the panel actually changed and retry.
apply_verified() {
    local want="$1" tries name low_id low_hz high_id high_hz cur_id cur_hz target
    for tries in 1 2 3; do
        apply "$want"
        read -r name low_id low_hz high_id high_hz cur_id cur_hz <<< "$(panel_info)"
        [ -n "$name" ] || return 1
        target="$high_id"
        [ "$want" = "low" ] && target="$low_id"
        [ "$cur_id" = "$target" ] && return 0
        sleep 1
    done
    return 1
}

case "$1" in
    auto|low|high)
        echo "$1" > "$MODE_FILE"
        apply_verified "$(desired)"
        ;;
    sync)
        apply_verified "$(desired)"
        ;;
    status)
        read -r name low_id low_hz high_id high_hz cur_id cur_hz <<< "$(panel_info)"
        if [ -n "$name" ]; then
            echo "$(saved_mode) $low_hz $high_hz $cur_hz"
        else
            echo "$(saved_mode) 60 60 60"
        fi
        ;;
    *)
        echo "Usage: $0 [auto|low|high|sync|status]"
        exit 1
        ;;
esac
