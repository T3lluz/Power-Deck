<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Power Deck</vendor>
  <vendor_url>https://github.com/T3lluz/Power-Deck</vendor_url>
  <icon_name>preferences-system-power-management</icon_name>
  <action id="org.fredde.powerdeck.setprofile">
    <description>Switch ASUS performance profile</description>
    <message>Authentication is required to switch the performance profile</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
